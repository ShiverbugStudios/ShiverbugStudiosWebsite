# Everything committed outside the folders _config.yml excludes is published
# by GitHub Pages at a guessable address. Working documents never go in.

# Notes, feedback and planning about the site
docs/
notes/

# Decks, contracts and exports sent over for reference
*.pdf
*.pptx
*.ppt
*.docx
*.doc
*.xlsx

# Art project files that get dragged in alongside exports
*.blend
*.blend1
*.psd
*.ztl
*.tif
*.tiff

# Full-resolution originals: source/ holds web-sized masters only
_originals/

# Python and OS clutter
__pycache__/
*.pyc
Thumbs.db
desktop.ini
.DS_Store
